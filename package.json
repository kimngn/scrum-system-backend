{
  "name": "recipe-backend",
  "version": "1.0.0",
  "description": "Recipe Node.js with Rest API",
  "main": "server.js",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:badge": "coverage-badges",
    "coverage:full": "npm test -- --coverage && coverage-badges",
    "start": "node server.js",
    "init-db": "node scripts/init-db.js",
    "init-db:wipe": "node scripts/init-db.js --wipe",
    "init-db:keep": "node scripts/init-db.js --no-wipe",
    "bundle": "mkdir -p deploy && cp -r app server.js package.json package-lock.json scrum-system-backend.service .env deploy"
  },
  "keywords": [
    "node.js",
    "express",
    "sequelize"
  ],
  "author": "cs",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cohere-ai": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "googleapis": "^118.0.0",
    "jest": "^29.3.1",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.2.3",
    "parse": "^4.0.1",
    "sequelize": "^6.19.0",
    "supertest": "^6.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "coverage-badges": "^1.0.7",
    "vitest": "^4.1.10"
  }
}
